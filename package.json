{
  "name": "professional-website",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://exampledesign.co.uk/",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "preexport": "node ./scripts/generate-curated-manifest.mjs",
    "postbuild": "node ./scripts/generate-curated-manifest.mjs",
    "export": "node -e \"console.log('Skipping next export: handled by output: export in next.config.mjs')\"",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --selectProjects unit --passWithNoTests",
    "test:integration": "jest --selectProjects integration --passWithNoTests",
    "test:accessibility": "jest --selectProjects accessibility --passWithNoTests || true",
    "test:performance": "jest --selectProjects performance --passWithNoTests || true",
    "test:visual": "jest --selectProjects visual --passWithNoTests || true",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lighthouse": "lhci autorun --config=./lighthouserc.js || true",
    "analyze": "cross-env ANALYZE=true next build",
    "test-export": "bash ./scripts/test-static-export.sh",
    "serve-static": "npx serve out"
  },
